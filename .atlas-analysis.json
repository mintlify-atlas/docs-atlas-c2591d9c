  "keyFeatures": [
    "End-to-end type safety from database schema to UI components using oRPC contracts",
    "Real-time message streaming via Server-Sent Events with type-safe event publishers",
    "AI assistant integration with @ai mentions, tool calling, and configurable models",
    "Authentication with Better-Auth supporting email/password and Google OAuth",
    "File-based routing with TanStack Router and automatic code splitting",
    "TanStack Query integration with oRPC for automatic query options generation",
    "Drizzle ORM with automatic Zod schema generation from database tables",
    "Monorepo architecture with Bun workspaces for shared type safety"
  ],
  "publicApiSurface": [
    "GET /api/rpc/chat/channel - Get user's channels",
    "POST /api/rpc/chat/channel - Create a new channel",
    "GET /api/rpc/chat/channel/{uuid} - Get a channel by id",
    "DELETE /api/rpc/chat/channel/{uuid} - Delete a channel",
    "POST /api/rpc/chat/channel/{uuid}/leave - Leave a channel",
    "POST /api/rpc/chat/channel/{uuid}/remove-member - Remove a member",
    "POST /api/rpc/chat/channel/{uuid}/add-members - Add members to a channel",
    "GET /api/rpc/chat/channel/{uuid}/settings - Get channel settings",
    "POST /api/rpc/chat/channel/{uuid}/settings - Set channel settings",
    "GET /api/rpc/chat/channel/{uuid}/message - Get channel messages",
    "POST /api/rpc/chat/channel/{uuid}/message - Send a message",
    "GET /api/rpc/chat/channel/{uuid}/message/stream - Stream messages (SSE)",
    "POST /api/rpc/user/search - Search for users",
    "POST /api/auth/** - Better-Auth endpoints (sign-in, sign-up, OAuth)"
  ]
}
